<!DOCTYPE html>
<html>
  <head>
    <title>Reptrack</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# csrf_meta_tags emits the token the checkout JS reads for its POST. %>
    <%= csrf_meta_tags %>

    <%# Tailwind (tailwindcss-rails) for the Rails-rendered pages. The inline
        block below only styles the raw HTML the checkout JS injects at runtime
        (.error / <pre>), which Tailwind utilities can't reach. %>
    <%= stylesheet_link_tag "tailwind" %>
    <style>
      pre { background: #f4f4f5; padding: 1rem; overflow-x: auto; border-radius: 4px; }
      .error { color: #b00020; }
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
