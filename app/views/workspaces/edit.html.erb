<%# Onboarding step: collect workspace details before provisioning. Posts to
    WorkspacesController#update (PATCH /billing/workspace), which flips status to
    :provisioning and enqueues ProvisionJob. Fields match workspace_params. %>
<% frontend_url = @frontend_url || ENV["FRONTEND_URL"].presence || "http://localhost:8000" %>

<div class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100">

  <%# ── Nav (same as checkout page) ─────────────────────────────────────── %>
  <nav class="flex items-center justify-between px-6 py-4 border-b border-stone-200">
    <a href="<%= frontend_url %>" class="flex items-center gap-2 font-bold text-lg">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-500">
        <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z"/>
          <path d="m2.5 21.5 1.4-1.4"/>
          <path d="m20.1 3.9 1.4-1.4"/>
          <path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z"/>
          <path d="m9.6 14.4 4.8-4.8"/>
        </svg>
      </span>
      RepTrack
    </a>
    <% if current_user %>
      <%= button_to "Sign Out", destroy_user_session_path,
        method: :delete,
        data: { turbo: false },
        class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 cursor-pointer" %>
    <% else %>
      <a href="<%= frontend_url %>?verified=true"
         class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
        Sign in
      </a>
    <% end %>
  </nav>

  <main class="px-4 py-12 sm:py-20">
    <div class="mx-auto w-full max-w-lg">

      <%# Progress: payment done, details current, provisioning next %>
      <ol class="mb-8 flex items-center gap-2 text-xs font-medium">
        <li class="flex items-center gap-1.5 text-emerald-600">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.3 3.29 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/>
          </svg>
          Payment
        </li>
        <li class="h-px flex-1 bg-slate-300" aria-hidden="true"></li>
        <li class="text-slate-900">Workspace</li>
        <li class="h-px flex-1 bg-slate-200" aria-hidden="true"></li>
        <li class="text-slate-400">Ready</li>
      </ol>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-200/50">
        <div class="border-b border-slate-100 px-8 pt-8 pb-6">
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">Set up your workspace</h1>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">
            Your payment went through. Pick a name and a web address — this is where your team will sign in.
          </p>
        </div>

        <%= form_with model: @workspace, url: billing_workspace_path, method: :patch, class: "space-y-6 px-8 py-7" do |f| %>

          <% if @workspace.errors.any? %>
            <div role="alert" class="flex gap-3 rounded-xl border border-red-200 bg-red-50 p-4">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-red-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm-.75-11.25a.75.75 0 0 1 1.5 0v3.5a.75.75 0 0 1-1.5 0v-3.5ZM10 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
              </svg>
              <div class="text-sm text-red-700">
                <p class="font-semibold">We couldn't save that</p>
                <ul class="mt-1 list-inside list-disc space-y-0.5 text-red-600">
                  <% @workspace.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <div>
            <%= f.label :name, "Workspace name", class: "block text-sm font-semibold text-slate-800" %>
            <p class="mt-0.5 text-xs text-slate-500">Usually your gym or company name.</p>
            <%= f.text_field :name,
                  placeholder: "Iron Works Fitness",
                  autofocus: true,
                  autocomplete: "organization",
                  class: "mt-2 block w-full rounded-xl border-0 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset #{@workspace.errors[:name].any? ? 'ring-red-300' : 'ring-slate-200'} placeholder:text-slate-400 transition focus:bg-white focus:ring-2 focus:ring-inset focus:ring-slate-900" %>
          </div>

          <div>
            <%= f.label :subdomain, "Web address", class: "block text-sm font-semibold text-slate-800" %>
            <p class="mt-0.5 text-xs text-slate-500">Lowercase letters, numbers and hyphens. You can't change this later.</p>
            <div class="mt-2 flex rounded-xl bg-slate-50 shadow-sm ring-1 ring-inset <%= @workspace.errors[:subdomain].any? ? 'ring-red-300' : 'ring-slate-200' %> transition focus-within:bg-white focus-within:ring-2 focus-within:ring-inset focus-within:ring-slate-900">
              <%= f.text_field :subdomain,
                    placeholder: "ironworks",
                    autocapitalize: "off",
                    autocorrect: "off",
                    spellcheck: "false",
                    class: "block w-full min-w-0 flex-1 rounded-l-xl border-0 bg-transparent px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:ring-0" %>
              <span class="inline-flex select-none items-center rounded-r-xl border-l border-slate-200 px-3.5 text-sm text-slate-500">
                .reptrack.app
              </span>
            </div>
          </div>

          <%= f.submit "Continue",
                data: { disable_with: "Setting up…" },
                class: "w-full cursor-pointer rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 disabled:opacity-60" %>
        <% end %>
      </div>

      <p class="mt-5 text-center text-xs text-slate-400">
        Setting up takes a few seconds. We'll email you if anything goes wrong.
      </p>
    </div>
  </main>
</div>
